DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=haskins_db
DB_USER=haskins_app   # a user limited to this database (never root in production)
DB_PASSWORD=replace-me
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
# Set COOKIE_SECURE=true when serving HTTPS
COOKIE_SECURE=false
ADMIN_ORIGIN=http://localhost:3001

# Email for new website inquiries, account invitations and password-reset links.
# Leave SMTP_HOST empty to disable: inquiries are still saved, and the admin is shown
# invitation/reset links to copy and send by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Haskins Demo <demo@gmail.com>"
# Local capture only: npm run mail:demo, SMTP_HOST=127.0.0.1, SMTP_PORT=1025,
# SMTP_USER=, SMTP_PASS=, SMTP_SECURE=false, SMTP_DEMO=true.
# Replace sender/SMTP settings with the client's mailbox before production.
SMTP_DEMO=false
# Recipients (comma separated). If empty, the management email from the admin's Site settings is used.
INQUIRY_NOTIFY_TO=

# Private tenant PDFs; keep outside public/ and UPLOAD_DIR and include in encrypted backups.
PRIVATE_DOCUMENT_DIR=private-tenant-files

# Two-step sign-in (MFA) for administrators.
# MFA_ENCRYPTION_KEY encrypts the authenticator secrets in the database. Required in production;
# generate once (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
# and keep it with your backups — if it is lost, every admin must have two-step sign-in reset.
MFA_ENCRYPTION_KEY=
# true = every administrator must set up two-step sign-in before using the admin panel
ADMIN_MFA_REQUIRED=false
