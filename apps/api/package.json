{
  "name": "@haskins/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && cp -r src/migrations dist/migrations",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "admin:create": "tsx src/admin-create.ts",
    "seed": "tsx src/seed.ts",
    "test:integration": "tsx test/cms.integration.ts",
    "test:roles": "tsx test/roles.integration.ts",
    "test:password": "tsx test/password.integration.ts",
    "test:mfa": "tsx test/mfa.integration.ts",
    "test:portal": "tsx test/portal.integration.ts",
    "launch:check": "tsx src/launch-check.ts",
    "backup": "node ../../scripts/backup.mjs",
    "seo:export": "tsx src/seo-transfer.ts export",
    "seo:import": "tsx src/seo-transfer.ts import",
    "admin:secure": "tsx src/admin-secure.ts"
  },
  "dependencies": {
    "@haskins/shared": "*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.21.4",
    "tsx": "^4.20.0"
  }
}
